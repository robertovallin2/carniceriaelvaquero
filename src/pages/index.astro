---
import "../styles/global.css";
import polloImg from "../assets/pollo.webp";
import logoCuernos from "../assets/logo-cuernos.png";
import redLogo from "../assets/logo-red.png";
import { Beef, MapPin, ChefHat } from "lucide-astro";
const title = "Carnicería El Vaquero | Cortes Premium en Aguascalientes";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-stone-50 text-stone-800 font-sans antialiased">
    <nav
      id="navbar"
      class="bg-stone-900 text-white py-4 px-4 fixed w-full z-50 shadow-lg transition-all duration-500 ease-in-out"
    >
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <!-- Contenedor del Logo y Texto -->
        <a href="#inicio" class="flex items-center">
          <!-- Imagen: Inicia más grande (h-14) y se encoge a (h-10) -->
          <img
            id="logo-img"
            src={logoCuernos.src}
            alt="El Vaquero Logo"
            class="h-14 w-auto transition-all duration-500 ease-in-out"
          />

          <!-- Texto: Inicia visible y se colapsa al hacer scroll -->
          <div
            id="logo-text-wrapper"
            class="hidden md:block transition-all duration-500 ease-in-out overflow-hidden max-w-[300px] opacity-100 pl-4"
          >
            <span
              class="text-2xl font-bold tracking-widest whitespace-nowrap font-serif font-bold text-red-600"
            >
              El Vaquero
            </span>
          </div>
        </a>

        <!-- Menú de navegación -->
        <ul class="hidden md:flex space-x-8 text-sm font-light tracking-wide">
          <li>
            <a href="#inicio" class="hover:text-red-500 transition-colors"
              >Inicio</a
            >
          </li>
          <li>
            <a href="#cortes" class="hover:text-red-500 transition-colors"
              >Nuestros Productos</a
            >
          </li>
          <li>
            <a href="#ubicacion" class="hover:text-red-500 transition-colors"
              >Ubicación</a
            >
          </li>
        </ul>
      </div>
    </nav>

    <!-- Hero Section -->
    <section
      id="inicio"
      class="relative pt-32 pb-20 md:pt-48 md:pb-32 bg-stone-900 overflow-hidden"
    >
      <!-- Overlay oscuro para elegancia -->
      <div class="absolute inset-0 bg-black/60 z-10"></div>
      <!-- Imagen de fondo (placeholder) -->
      <img
        src="https://images.unsplash.com/photo-1603048297172-c92544798d5e?q=80&w=2070&auto=format&fit=crop"
        alt="Cortes de carne premium"
        class="absolute inset-0 w-full h-full object-cover z-0 opacity-50"
      />

      <div class="relative z-20 max-w-7xl mx-auto px-6 text-center">
        <span
          class="text-red-500 font-semibold tracking-[0.2em] uppercase text-sm mb-4 block"
        >
          Tradición y Calidad en Aguascalientes
        </span>
        <h2
          class="text-5xl md:text-7xl font-serif font-bold text-white mb-6 drop-shadow-lg"
        >
          CARNICERÍA <span class="text-red-600">EL VAQUERO</span>
        </h2>
        <p
          class="text-stone-300 max-w-2xl mx-auto text-lg md:text-xl font-light mb-10"
        >
          Elevamos tu experiencia en la parrilla con la mejor carne de la
          región.
        </p>
        <a
          href="#cortes"
          class="inline-block bg-red-700 hover:bg-red-800 text-white font-medium py-3 px-8 rounded-sm transition-all duration-300 shadow-[0_0_15px_rgba(185,28,28,0.5)]"
        >
          Descubre nuestros productos
        </a>
      </div>
    </section>

    <!-- Sección de Atributos -->
    <section class="py-20 bg-white">
      <div
        class="max-w-7xl mx-auto px-6 grid md:grid-cols-3 gap-12 text-center"
      >
        <div>
          <div
            class="w-16 h-16 mx-auto bg-red-50 text-red-700 rounded-full flex items-center justify-center mb-6"
          >
            <Beef class="w-8 h-8" />
          </div>
          <h3 class="text-xl font-serif font-bold mb-3">Calidad Premium</h3>
          <p class="text-stone-600 font-light">
            Ganado seleccionado meticulosamente para garantizar la máxima
            suavidad y sabor en cada bocado.
          </p>
        </div>
        <div>
          <div
            class="w-16 h-16 mx-auto bg-red-50 text-red-700 rounded-full flex items-center justify-center mb-6"
          >
            <MapPin class="w-8 h-8" />
          </div>
          <h3 class="text-xl font-serif font-bold mb-3">Orgullo Hidrocálido</h3>
          <p class="text-stone-600 font-light">
            19 AÑOS trabajando para ti, apoyando la economía local y sirviendo a
            nuestra comunidad.
          </p>
        </div>
        <div>
          <div
            class="w-16 h-16 mx-auto bg-red-50 text-red-700 rounded-full flex items-center justify-center mb-6"
          >
            <ChefHat class="w-8 h-8" />
          </div>
          <h3 class="text-xl font-serif font-bold mb-3">Cortes Maestros</h3>
        </div>
      </div>
    </section>

    <!-- Productos / Cortes -->
    <section id="cortes" class="py-24 bg-stone-100">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-serif font-bold text-stone-900 mb-4">
            Nuestra Selección
          </h2>
          <div class="w-24 h-1 bg-red-600 mx-auto"></div>
        </div>

        <div class="grid md:grid-cols-4 gap-8">
          <!-- CARD 1: CERDO -->
          <div
            class="tarjeta-producto relative bg-white group overflow-hidden shadow-sm hover:shadow-xl transition-shadow duration-300 cursor-pointer h-[520px]"
          >
            <!-- Frente -->
            <div
              class="absolute inset-0 transition-opacity duration-500 ease-in-out group-hover:opacity-0 group-[.active]:opacity-0 flex flex-col"
            >
              <div class="h-64 overflow-hidden bg-stone-200 shrink-0">
                <img
                  src="https://images.unsplash.com/photo-1558030006-450675393462?q=80&w=2069&auto=format&fit=crop"
                  alt="Cerdo"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>

              <div
                class="p-8 text-center border-t-4 border-red-700 flex-grow flex flex-col justify-center"
              >
                <h3 class="text-2xl font-serif font-bold mb-2">
                  Cerdo de Primera Calidad
                </h3>

                <p class="text-sm text-stone-500 mt-3 md:hidden">
                  Toca para ver los cortes
                </p>
              </div>
            </div>

            <!-- Reverso -->
            <div
              class="absolute inset-0 bg-stone-900 text-stone-100 p-6 flex items-center justify-center text-center opacity-0 group-hover:opacity-100 group-[.active]:opacity-100 transition-opacity duration-500 ease-in-out border-t-4 border-red-700"
            >
              <ul class="w-full space-y-3">
                <li
                  class="bg-stone-50 px-4 py-2.5 rounded text-stone-600 font-light border-l-2 border-red-600"
                >
                  Bistec de puerco
                </li>
                <li
                  class="bg-stone-50 px-4 py-2.5 rounded text-stone-600 font-light border-l-2 border-red-600"
                >
                  Trocitos y costilla
                </li>
                <li
                  class="bg-stone-50 px-4 py-2.5 rounded text-stone-600 font-light border-l-2 border-red-600"
                >
                  Buche y Lengua
                </li>
                <li
                  class="bg-stone-50 px-4 py-2.5 rounded text-stone-600 font-light border-l-2 border-red-600"
                >
                  Espinazo y Chamorro
                </li>
                <li
                  class="bg-stone-50 px-4 py-2.5 rounded text-stone-600 font-light border-l-2 border-red-600"
                >
                  Lechón y Cabeza de puerco
                </li>
                <li
                  class="bg-stone-50 px-4 py-2.5 rounded text-stone-600 font-light border-l-2 border-red-600"
                >
                  Chicharrón prensado y duro
                </li>
              </ul>
            </div>
          </div>

          <!-- CARD 2: ESPECIALIDADES -->
          <div
            class="tarjeta-producto relative bg-white group overflow-hidden shadow-sm hover:shadow-xl transition-shadow duration-300 cursor-pointer h-[520px]"
          >
            <!-- Frente -->
            <div
              class="absolute inset-0 transition-opacity duration-500 ease-in-out group-hover:opacity-0 group-[.active]:opacity-0 flex flex-col"
            >
              <div class="h-64 overflow-hidden bg-stone-200 shrink-0">
                <img
                  src="https://images.unsplash.com/photo-1615937691194-97dbd3f3dc29?q=80&w=2070&auto=format&fit=crop"
                  alt="Especialidades"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>

              <div
                class="p-8 text-center border-t-4 border-red-700 flex-grow flex flex-col justify-center"
              >
                <h3 class="text-2xl font-serif font-bold mb-2">
                  Especialidades de la Casa
                </h3>

                <p class="text-sm text-stone-500 mt-3 md:hidden">
                  Toca para ver las especialidades
                </p>
              </div>
            </div>

            <!-- Reverso -->
            <div
              class="absolute inset-0 bg-stone-900 text-stone-100 p-6 flex items-center justify-center text-center opacity-0 group-hover:opacity-100 group-[.active]:opacity-100 transition-opacity duration-500 ease-in-out border-t-4 border-red-700"
            >
              <ul class="w-full space-y-3">
                <li
                  class="bg-stone-50 px-4 py-2.5 rounded text-stone-600 font-light border-l-2 border-orange-500"
                >
                  Pastor
                </li>
                <li
                  class="bg-stone-50 px-4 py-2.5 rounded text-stone-600 font-light border-l-2 border-orange-500"
                >
                  Adobada
                </li>
                <li
                  class="bg-stone-50 px-4 py-2.5 rounded text-stone-600 font-light border-l-2 border-orange-500"
                >
                  Chorizo
                </li>
                <li
                  class="bg-stone-50 px-4 py-2.5 rounded text-stone-600 font-light border-l-2 border-orange-500"
                >
                  Alitas adobadas
                </li>
              </ul>
            </div>
          </div>

          <!-- CARD 3: RES -->
          <div
            class="tarjeta-producto relative bg-white group overflow-hidden shadow-sm hover:shadow-xl transition-shadow duration-300 cursor-pointer h-[520px]"
          >
            <!-- Frente -->
            <div
              class="absolute inset-0 transition-opacity duration-500 ease-in-out group-hover:opacity-0 group-[.active]:opacity-0 flex flex-col"
            >
              <div class="h-64 overflow-hidden bg-stone-200 shrink-0">
                <img
                  src="https://images.unsplash.com/photo-1529692236671-f1f6cf9683ba?q=80&w=2070&auto=format&fit=crop"
                  alt="Cortes de res"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>

              <div
                class="p-8 text-center border-t-4 border-red-700 flex-grow flex flex-col justify-center"
              >
                <h3 class="text-2xl font-serif font-bold mb-2">
                  Cortes de Res Selectos
                </h3>

                <p class="text-sm text-stone-500 mt-3 md:hidden">
                  Toca para ver los cortes
                </p>
              </div>
            </div>

            <!-- Reverso -->
            <div
              class="absolute inset-0 bg-stone-900 text-stone-100 p-6 flex items-center justify-center text-center opacity-0 group-hover:opacity-100 group-[.active]:opacity-100 transition-opacity duration-500 ease-in-out border-t-4 border-red-700"
            >
              <ul class="w-full space-y-3">
                <li
                  class="bg-stone-50 px-4 py-2.5 rounded text-stone-600 font-light border-l-2 border-red-800"
                >
                  Bistec
                </li>
                <li
                  class="bg-stone-50 px-4 py-2.5 rounded text-stone-600 font-light border-l-2 border-red-800"
                >
                  Chuleta
                </li>
                <li
                  class="bg-stone-50 px-4 py-2.5 rounded text-stone-600 font-light border-l-2 border-red-800"
                >
                  Costilla
                </li>
                <li
                  class="bg-stone-50 px-4 py-2.5 rounded text-stone-600 font-light border-l-2 border-red-800"
                >
                  Rib Eye
                </li>
              </ul>
            </div>
          </div>

          <!-- CARD 4: POLLO -->
          <div
            class="tarjeta-producto relative bg-white group overflow-hidden shadow-sm hover:shadow-xl transition-shadow duration-300 cursor-pointer h-[520px]"
          >
            <!-- Frente -->
            <div
              class="absolute inset-0 transition-opacity duration-500 ease-in-out group-hover:opacity-0 group-[.active]:opacity-0 flex flex-col"
            >
              <div class="h-64 overflow-hidden bg-stone-200 shrink-0">
                <img
                  src={polloImg.src}
                  alt="Pollo"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>

              <div
                class="p-8 text-center border-t-4 border-red-700 flex-grow flex flex-col justify-center"
              >
                <h3 class="text-2xl font-serif font-bold mb-2">
                  Pollo Fresco del Día
                </h3>

                <p class="text-sm text-stone-500 mt-3 md:hidden">
                  Toca para ver los cortes
                </p>
              </div>
            </div>

            <!-- Reverso -->
            <div
              class="absolute inset-0 bg-stone-900 text-stone-100 p-6 flex items-center justify-center text-center opacity-0 group-hover:opacity-100 group-[.active]:opacity-100 transition-opacity duration-500 ease-in-out border-t-4 border-red-700"
            >
              <ul class="w-full space-y-3">
                <li
                  class="bg-stone-50 px-4 py-2.5 rounded text-stone-600 font-light border-l-2 border-yellow-500"
                >
                  Pierna y muslo
                </li>
                <li
                  class="bg-stone-50 px-4 py-2.5 rounded text-stone-600 font-light border-l-2 border-yellow-500"
                >
                  Pechuga y filete de pollo
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </body>
  <!-- Footer / Ubicación -->
  <footer
    id="ubicacion"
    class="bg-stone-900 text-stone-400 py-12 border-t border-stone-800"
  >
    <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-8 items-center">
      <div>
        <h2 class="text-3xl font-serif font-bold text-white mb-4">
          Visítanos en Aguascalientes
        </h2>
        <p class="mb-2">
          <strong class="text-red-500">Dirección:</strong> Av. Del Rey #135, Mujeres
          Ilustres, Aguascalientes, Ags.
        </p>
        <p class="mb-2">
          <strong class="text-red-500">Teléfono:</strong> (449) 9759949
        </p>
        <p>
          <strong class="text-red-500">Horario:</strong> Lunes a Domingo, 8:30 AM
          - 5:00 PM (Cerrado los Martes)
        </p>
      </div>
      <div class="flex flex-col gap-4 items-end">
        <div class="flex gap-2 items-center">
          <img
            src={logoCuernos.src}
            alt="El Vaquero Logo"
            class="h-12 w-auto"
          />
          <span class="text-red-600 uppercase font-serif font-bold text-3xl"
            >El Vaquero</span
          >
        </div>

        <p class="text-sm">
          © 2026 Carnicería El Vaquero. Todos los derechos reservados.
        </p>
      </div>
    </div>
  </footer>
</html>

<script>
  function toggleNavbarOnScroll() {
    const navbar = document.getElementById("navbar");
    const logoImg = document.getElementById("logo-img");
    const textWrapper = document.getElementById("logo-text-wrapper");

    if (!navbar || !logoImg || !textWrapper) return;

    if (window.scrollY > 20) {
      navbar.classList.remove("py-4");
      navbar.classList.add("py-2");
      logoImg.classList.remove("h-14");
      logoImg.classList.add("h-10");
      textWrapper.classList.remove("max-w-[300px]", "opacity-100", "pl-4");
      textWrapper.classList.add("max-w-0", "opacity-0", "pl-0");
    } else {
      navbar.classList.remove("py-2");
      navbar.classList.add("py-4");
      logoImg.classList.remove("h-10");
      logoImg.classList.add("h-14");
      textWrapper.classList.remove("max-w-0", "opacity-0", "pl-0");
      textWrapper.classList.add("max-w-[300px]", "opacity-100", "pl-4");
    }
  }

  window.addEventListener("scroll", toggleNavbarOnScroll);
  toggleNavbarOnScroll();

  // --- NUEVA LÓGICA DE LAS TARJETAS ---
  const tarjetas = document.querySelectorAll(".tarjeta-producto");

  tarjetas.forEach((tarjeta) => {
    tarjeta.addEventListener("click", function (e) {
      // Verificamos si la tarjeta actual ya está activa
      const estaActiva = this.classList.contains("active");

      // 1. Removemos la clase 'active' de TODAS las tarjetas
      tarjetas.forEach((t) => t.classList.remove("active"));

      // 2. Si la tarjeta que tocamos NO estaba activa, la activamos.
      // (Si ya estaba activa, se quedará cerrada gracias al paso anterior).
      if (!estaActiva) {
        this.classList.add("active");
      }
    });
  });

  // (Opcional) Cerrar las tarjetas si el usuario toca en cualquier otra parte de la pantalla
  document.addEventListener("click", function (e) {
    if (!e.target.closest(".tarjeta-producto")) {
      tarjetas.forEach((t) => t.classList.remove("active"));
    }
  });
</script>
